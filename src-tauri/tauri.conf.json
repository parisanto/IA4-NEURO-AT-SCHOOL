{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IA4-NEURO",
  "version": "1.0.1",
  "identifier": "fr.ia4school.ia4neuro",
  "build": {
    "beforeDevCommand": "pnpm run build:desktop",
    "beforeBuildCommand": "pnpm run build:desktop",
    "frontendDist": "../dist/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IA4-NEURO",
        "width": 1280,
        "height": 820,
        "minWidth": 840,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; media-src 'self' asset: blob:; font-src 'self' asset: data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["script-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Outils pédagogiques adaptés aux élèves DYS, TDAH et TSA.",
    "longDescription": "IA4-NEURO aide les élèves à comprendre, organiser et préparer leur travail scolaire, même sans connexion Internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
